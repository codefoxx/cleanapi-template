<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>

        <PackageType>Template</PackageType>
        <PackageId>Codefox.CleanApi.Template</PackageId>
        <Title>Codefox Clean API Template</Title>
        <Authors>Codefox</Authors>
        <Description>Clean Architecture Web API template with EF Core, Aspire, Keycloak, Testcontainers and Serilog.</Description>
        <Version>0.1.0</Version>

        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <NoDefaultExcludes>true</NoDefaultExcludes>

        <EnableDefaultItems>false</EnableDefaultItems>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

        <NoBuild>true</NoBuild>
        <NoWarn>$(NoWarn);NU5128</NoWarn>

        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageOutputPath>$(MSBuildThisFileDirectory)bin/$(Configuration)/</PackageOutputPath>
        <TemplateShortName>cleanapi</TemplateShortName>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md"
              Pack="true"
              PackagePath="\"
              Link="README.md" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)..\content\**\*"
              Exclude="
                  $(MSBuildThisFileDirectory)..\content\**\bin\**;
                  $(MSBuildThisFileDirectory)..\content\**\obj\**;
                  $(MSBuildThisFileDirectory)..\content\.idea\**;
                  $(MSBuildThisFileDirectory)..\content\*.DotSettings.user"
              Pack="true"
              PackagePath="content\" />
    </ItemGroup>

    <ItemGroup>
      <Compile Include="..\content\tests\Company.Template.Infrastructure.Tests\GlobalUsings.cs">
        <Link>tests\Company.Template.Infrastructure.Tests\GlobalUsings.cs</Link>
      </Compile>
    </ItemGroup>

    <Target Name="CleanTemplateArtifacts">
        <Message Importance="high" Text="Cleaning template build artifacts..." />

        <RemoveDir Directories="$(MSBuildThisFileDirectory)..\content\src\Company.Template.Api\bin" />
        <RemoveDir Directories="$(MSBuildThisFileDirectory)..\content\src\Company.Template.Api\obj" />

        <RemoveDir Directories="$(MSBuildThisFileDirectory)..\content\src\Company.Template.Application\bin" />
        <RemoveDir Directories="$(MSBuildThisFileDirectory)..\content\src\Company.Template.Application\obj" />

        <RemoveDir Directories="$(MSBuildThisFileDirectory)..\content\src\Company.Template.Domain\bin" />
        <RemoveDir Directories="$(MSBuildThisFileDirectory)..\content\src\Company.Template.Domain\obj" />

        <RemoveDir Directories="$(MSBuildThisFileDirectory)..\content\src\Company.Template.Infrastructure\bin" />
        <RemoveDir Directories="$(MSBuildThisFileDirectory)..\content\src\Company.Template.Infrastructure\obj" />

        <RemoveDir Directories="$(MSBuildThisFileDirectory)..\content\src\Company.Template.ServiceDefaults\bin" />
        <RemoveDir Directories="$(MSBuildThisFileDirectory)..\content\src\Company.Template.ServiceDefaults\obj" />

        <RemoveDir Directories="$(MSBuildThisFileDirectory)..\content\src\Company.Template.AppHost\bin" />
        <RemoveDir Directories="$(MSBuildThisFileDirectory)..\content\src\Company.Template.AppHost\obj" />

        <RemoveDir Directories="$(MSBuildThisFileDirectory)..\content\tests\Company.Template.Domain.Tests\bin" />
        <RemoveDir Directories="$(MSBuildThisFileDirectory)..\content\tests\Company.Template.Domain.Tests\obj" />

        <RemoveDir Directories="$(MSBuildThisFileDirectory)..\content\tests\Company.Template.Application.Tests\bin" />
        <RemoveDir Directories="$(MSBuildThisFileDirectory)..\content\tests\Company.Template.Application.Tests\obj" />

        <RemoveDir Directories="$(MSBuildThisFileDirectory)..\content\tests\Company.Template.Infrastructure.Tests\bin" />
        <RemoveDir Directories="$(MSBuildThisFileDirectory)..\content\tests\Company.Template.Infrastructure.Tests\obj" />

        <RemoveDir Directories="$(MSBuildThisFileDirectory)..\content\tests\Company.Template.Api.Tests\bin" />
        <RemoveDir Directories="$(MSBuildThisFileDirectory)..\content\tests\Company.Template.Api.Tests\obj" />

        <RemoveDir Directories="$(MSBuildThisFileDirectory)..\content\.idea" />
        <Delete Files="$(MSBuildThisFileDirectory)..\content\Company.Template.sln.DotSettings.user"
                TreatErrorsAsWarnings="true" />
    </Target>

    <Target Name="InstallTemplate" DependsOnTargets="CleanTemplateArtifacts;Pack">
        <PropertyGroup>
            <TemplatePackageFile>$(PackageOutputPath)$(PackageId).$(Version).nupkg</TemplatePackageFile>
        </PropertyGroup>

        <Message Importance="high" Text="Uninstalling existing template package $(PackageId) if installed..." />
        <Exec Command="dotnet new uninstall $(PackageId)" IgnoreExitCode="true" />

        <Message Importance="high" Text="Installing template package $(TemplatePackageFile)..." />
        <Exec Command="dotnet new install &quot;$(TemplatePackageFile)&quot; --force" />

        <Message Importance="high" Text="Installed templates matching $(TemplateShortName):" />
        <Exec Command="dotnet new list $(TemplateShortName)" IgnoreExitCode="true" />
    </Target>

</Project>