{
    "$schema": "http://json.schemastore.org/template",
    "author": "Codefox",
    "classifications": [
        "Web",
        "WebAPI",
        "Clean Architecture",
        "DDD",
        "Aspire"
    ],
    "identity": "Codefox.CleanApi.Template",
    "name": "Clean Architecture Web API",
    "shortName": "cleanapi",
    "sourceName": "Company.Template",
    "preferNameDirectory": true,
    "description": "Production-oriented Clean Architecture Web API template with EF Core, Aspire, optional Keycloak JWT bearer wiring, Testcontainers and sample DDD code.",
    "tags": {
        "language": "C#",
        "type": "project"
    },
    "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "**/BuildHost-*/**",
        ".template_config/**/*",
        ".idea/**/*",
        "*.DotSettings.user"
    ],
    "symbols": {
        "apiResourceNameRaw": {
            "type": "generated",
            "generator": "regex",
            "parameters": {
                "source": "name",
                "steps": [
                    {
                        "regex": "\\.",
                        "replacement": "-"
                    },
                    {
                        "regex": "^(.*)$",
                        "replacement": "$1-api"
                    }
                ]
            }
        },
        "apiResourceName": {
            "type": "derived",
            "datatype": "text",
            "valueSource": "apiResourceNameRaw",
            "valueTransform": "lowerCaseForm",
            "replaces": "__API_RESOURCE_NAME__"
        },
        "auth": {
            "type": "parameter",
            "datatype": "choice",
            "description": "Authentication mode used by the generated application.",
            "defaultValue": "Keycloak",
            "choices": [
                {
                    "choice": "None",
                    "description": "Generate the project without authentication artifacts."
                },
                {
                    "choice": "Keycloak",
                    "description": "Generate the project with enforced JWT bearer authentication backed by the sample Keycloak realm."
                }
            ]
        },
        "authAudienceRaw": {
            "type": "generated",
            "generator": "regex",
            "parameters": {
                "source": "name",
                "steps": [
                    {
                        "regex": "\\.",
                        "replacement": "-"
                    },
                    {
                        "regex": "^(.*)$",
                        "replacement": "$1-api"
                    }
                ]
            }
        },
        "authAudience": {
            "type": "derived",
            "datatype": "text",
            "valueSource": "authAudienceRaw",
            "valueTransform": "lowerCaseForm",
            "replaces": "__AUTH_AUDIENCE__"
        },
        "databaseNameRaw": {
            "type": "generated",
            "generator": "regex",
            "parameters": {
                "source": "name",
                "steps": [
                    {
                        "regex": "\\.",
                        "replacement": "_"
                    },
                    {
                        "regex": "-",
                        "replacement": "_"
                    }
                ]
            }
        },
        "databaseName": {
            "type": "derived",
            "datatype": "text",
            "valueSource": "databaseNameRaw",
            "valueTransform": "lowerCaseForm",
            "replaces": "__DATABASE_NAME__"
        },
        "databaseResourceNameRaw": {
            "type": "generated",
            "generator": "regex",
            "parameters": {
                "source": "name",
                "steps": [
                    {
                        "regex": "\\.",
                        "replacement": "-"
                    },
                    {
                        "regex": "^(.*)$",
                        "replacement": "$1-db"
                    }
                ]
            }
        },
        "databaseResourceName": {
            "type": "derived",
            "datatype": "text",
            "valueSource": "databaseResourceNameRaw",
            "valueTransform": "lowerCaseForm",
            "replaces": "__DATABASE_RESOURCE_NAME__"
        },
        "db": {
            "type": "parameter",
            "datatype": "choice",
            "description": "Database provider used by the generated application.",
            "defaultValue": "PostgreSql",
            "replaces": "__DB_PROVIDER__",
            "choices": [
                {
                    "choice": "PostgreSql",
                    "description": "Use PostgreSQL with Npgsql."
                },
                {
                    "choice": "SqlServer",
                    "description": "Use SQL Server."
                }
            ]
        },
        "keycloakRealmRaw": {
            "type": "generated",
            "generator": "regex",
            "parameters": {
                "source": "name",
                "steps": [
                    {
                        "regex": "\\.",
                        "replacement": "-"
                    }
                ]
            }
        },
        "keycloakRealm": {
            "type": "derived",
            "datatype": "text",
            "valueSource": "keycloakRealmRaw",
            "valueTransform": "lowerCaseForm",
            "replaces": "__KEYCLOAK_REALM__",
            "fileRename": "__KEYCLOAK_REALM__"
        },
        "keycloakResourceNameRaw": {
            "type": "generated",
            "generator": "regex",
            "parameters": {
                "source": "name",
                "steps": [
                    {
                        "regex": "\\.",
                        "replacement": "-"
                    },
                    {
                        "regex": "^(.*)$",
                        "replacement": "$1-keycloak"
                    }
                ]
            }
        },
        "keycloakResourceName": {
            "type": "derived",
            "datatype": "text",
            "valueSource": "keycloakResourceNameRaw",
            "valueTransform": "lowerCaseForm",
            "replaces": "__KEYCLOAK_RESOURCE_NAME__"
        },
        "migrationServiceResourceNameRaw": {
            "type": "generated",
            "generator": "regex",
            "parameters": {
                "source": "name",
                "steps": [
                    {
                        "regex": "\\.",
                        "replacement": "-"
                    },
                    {
                        "regex": "^(.*)$",
                        "replacement": "$1-migrations"
                    }
                ]
            }
        },
        "migrationServiceResourceName": {
            "type": "derived",
            "datatype": "text",
            "valueSource": "migrationServiceResourceNameRaw",
            "valueTransform": "lowerCaseForm",
            "replaces": "__MIGRATION_SERVICE_RESOURCE_NAME__"
        }
    },
    "forms": {
        "lowerCaseForm": {
            "identifier": "chain",
            "steps": [
                "lowerCaseInvariant"
            ]
        }
    },
    "sources": [
        {
            "source": "./",
            "target": "./",
            "exclude": [
                "**/[Bb]in/**",
                "**/[Oo]bj/**",
                "**/BuildHost-*/**",
                ".template_config/**/*",
                ".idea/**/*",
                "*.DotSettings.user",
                "Directory.Build.local.props",
                "src/Company.Template.AppHost/appsettings.json",
                "src/Company.Template.AppHost/appsettings.None.json",
                "src/Company.Template.AppHost/Providers/PostgreSqlAspireDatabase.cs",
                "src/Company.Template.AppHost/Providers/SqlServerAspireDatabase.cs",
                "src/Company.Template.Composition/appsettings.json",
                "src/Company.Template.Composition/appsettings.None.json",
                "src/Company.Template.Infrastructure/Persistence/Providers/DatabaseProviderConfigurator.PostgreSql.cs",
                "src/Company.Template.Infrastructure/Persistence/Providers/DatabaseProviderConfigurator.SqlServer.cs",
                "tests/Company.Template.TestSupport/Database/TestDatabase.PostgreSql.cs",
                "tests/Company.Template.TestSupport/Database/TestDatabase.SqlServer.cs",
                "tests/Company.Template.TestSupport/Database/TestDatabaseServer.PostgreSql.cs",
                "tests/Company.Template.TestSupport/Database/TestDatabaseServer.SqlServer.cs"
            ]
        },
        {
            "source": "./",
            "target": "./",
            "condition": "(auth == \"None\")",
            "include": [
                "src/Company.Template.AppHost/appsettings.None.json",
                "src/Company.Template.Composition/appsettings.None.json"
            ],
            "rename": {
                "src/Company.Template.AppHost/appsettings.None.json": "src/Company.Template.AppHost/appsettings.json",
                "src/Company.Template.Composition/appsettings.None.json": "src/Company.Template.Composition/appsettings.json"
            }
        },
        {
            "source": "./",
            "target": "./",
            "condition": "(auth == \"Keycloak\")",
            "include": [
                "src/Company.Template.AppHost/appsettings.json",
                "src/Company.Template.Composition/appsettings.json"
            ]
        },
        {
            "source": "./",
            "target": "./",
            "condition": "(db == \"PostgreSql\")",
            "include": [
                "src/Company.Template.AppHost/Providers/PostgreSqlAspireDatabase.cs",
                "src/Company.Template.Infrastructure/Persistence/Providers/DatabaseProviderConfigurator.PostgreSql.cs",
                "tests/Company.Template.TestSupport/Database/TestDatabase.PostgreSql.cs",
                "tests/Company.Template.TestSupport/Database/TestDatabaseServer.PostgreSql.cs"
            ],
            "rename": {
                "src/Company.Template.AppHost/Providers/PostgreSqlAspireDatabase.cs": "src/Company.Template.AppHost/Providers/AspireDatabase.cs",
                "src/Company.Template.Infrastructure/Persistence/Providers/DatabaseProviderConfigurator.PostgreSql.cs": "src/Company.Template.Infrastructure/Persistence/Providers/DatabaseProviderConfigurator.cs",
                "tests/Company.Template.TestSupport/Database/TestDatabase.PostgreSql.cs": "tests/Company.Template.TestSupport/Database/TestDatabaseProvider.cs",
                "tests/Company.Template.TestSupport/Database/TestDatabaseServer.PostgreSql.cs": "tests/Company.Template.TestSupport/Database/TestDatabaseServer.cs"
            }
        },
        {
            "source": "./",
            "target": "./",
            "condition": "(db == \"SqlServer\")",
            "include": [
                "src/Company.Template.AppHost/Providers/SqlServerAspireDatabase.cs",
                "src/Company.Template.Infrastructure/Persistence/Providers/DatabaseProviderConfigurator.SqlServer.cs",
                "tests/Company.Template.TestSupport/Database/TestDatabase.SqlServer.cs",
                "tests/Company.Template.TestSupport/Database/TestDatabaseServer.SqlServer.cs"
            ],
            "rename": {
                "src/Company.Template.AppHost/Providers/SqlServerAspireDatabase.cs": "src/Company.Template.AppHost/Providers/AspireDatabase.cs",
                "src/Company.Template.Infrastructure/Persistence/Providers/DatabaseProviderConfigurator.SqlServer.cs": "src/Company.Template.Infrastructure/Persistence/Providers/DatabaseProviderConfigurator.cs",
                "tests/Company.Template.TestSupport/Database/TestDatabase.SqlServer.cs": "tests/Company.Template.TestSupport/Database/TestDatabaseProvider.cs",
                "tests/Company.Template.TestSupport/Database/TestDatabaseServer.SqlServer.cs": "tests/Company.Template.TestSupport/Database/TestDatabaseServer.cs"
            }
        }
    ]
}