root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# EF Core migrations are generated code.
# Do not force file-scoped namespaces there because EF may regenerate files differently.
[**/Persistence/Migrations/*.cs]
dotnet_diagnostic.IDE0161.severity = none

# Composition abstraction namespaces intentionally omit the Abstractions
# project segment so consumers import the conceptual API.
[src/composition/Company.Template.Composition.Abstractions/Framework/*.cs]
dotnet_diagnostic.IDE0130.severity = none
resharper_check_namespace_highlighting = none

[src/composition/Company.Template.Composition.Abstractions/Features/*.cs]
dotnet_diagnostic.IDE0130.severity = none
resharper_check_namespace_highlighting = none

[*.{cs,csx}]
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Analyzer policy
#
# Some design analyzers are too broad for this template and conflict with
# deliberate C# API design choices.

# C# extension blocks can currently trigger CA1034 ("Do not nest type")
# because analyzers see the generated shape as a nested type.
# The template intentionally uses extension blocks, so this rule is disabled.
dotnet_diagnostic.CA1034.severity = none

# Option<T>, Error, and Set<TEntity> are intentional C# API names.
# CA1716 is mainly useful for libraries designed for broad cross-language consumption.
dotnet_diagnostic.CA1716.severity = none

# Option<T>.Some, Option<T>.None, Result<T>.Success, and Result<T>.Failure
# are intentional static factory methods on generic result-like types.
dotnet_diagnostic.CA1000.severity = none

# ASP.NET Core does not use the classic request synchronization context.
# Requiring ConfigureAwait(false) throughout application code adds noise without
# meaningful value for this template.
dotnet_diagnostic.CA2007.severity = none

# Qualification
#
# Prefer unqualified member access unless qualification improves readability.
# Example:
#   _dbContext.SaveChangesAsync(...)
#
# Avoid:
#   this._dbContext.SaveChangesAsync(...)
dotnet_style_qualification_for_event = false:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_property = false:suggestion

# Object / collection creation
#
# Prefer initializer syntax and modern collection expressions where applicable.
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_collection_expression = true:suggestion

# Immutability
#
# Fields that can be readonly should be readonly.
dotnet_style_readonly_field = true:warning

# Namespaces / braces
#
# Use file-scoped namespaces and always use braces for control-flow blocks.
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning

# var usage
#
# Prefer explicit types. This keeps the variable type visible on the left side and allows
# target-typed object creation on the right side.
#
# Examples:
#   ProductId productId = ProductId.From(command.ProductId);
#   Option<Product> maybe = await ...
#   ProblemDetails problem = new();
#
# Avoid:
#   var productId = ProductId.From(command.ProductId);
#   var maybe = await ...
#   var problem = new ProblemDetails();
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning

# Expression-bodied members
#
# Prefer block bodies for methods, constructors, operators, and local functions.
# Allow expression-bodied members for simple properties/accessors/lambdas when they fit on one line.
csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_operators = false:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_expression_bodied_indexers = when_on_single_line:suggestion
csharp_style_expression_bodied_accessors = when_on_single_line:suggestion
csharp_style_expression_bodied_lambdas = when_on_single_line:suggestion
csharp_style_expression_bodied_local_functions = false:suggestion

# Formatting
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_between_query_expression_clauses = true

csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = flush_left

csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_around_binary_operators = before_and_after

csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = false

# Rider / ReSharper: chained method calls
#
# Goal:
#   Option<Product> maybe = await _dbContext.Products
#       .WithId(productId)
#       .SingleOrNoneAsync(cancellationToken);
#
# Use chop_if_long if short chains may stay on one line.
# Use chop_always if fluent chains should always be split across lines.
resharper_csharp_wrap_chained_method_calls = chop_if_long
resharper_csharp_wrap_before_first_method_call = false
resharper_csharp_wrap_after_dot_in_method_calls = false
resharper_csharp_align_multiline_chained_method_calls = true

# Rider / ReSharper: binary expressions
#
# Keep multiline boolean expressions readable without over-aligning them.
resharper_csharp_wrap_before_binary_opsign = true
resharper_csharp_align_multiline_binary_expressions_chain = false

# Rider / ReSharper: argument and parameter wrapping
#
# Use chop_if_long so short calls stay compact while longer calls are wrapped.
# Do not align arguments/parameters vertically; prefer a simple indentation style.
resharper_csharp_wrap_arguments_style = chop_if_long
resharper_csharp_wrap_parameters_style = chop_if_long
resharper_csharp_align_multiline_argument = false
resharper_csharp_align_multiline_parameter = false

# Rider / ReSharper: object and collection initializers
#
# Keep short initializers compact, but wrap long initializers.
# Do not vertically align initializer values.
resharper_csharp_wrap_object_and_collection_initializer_style = chop_if_long
resharper_csharp_align_multiline_array_and_object_initializer = false

# Rider / ReSharper: LINQ query expressions
#
# Wrap longer LINQ expressions without vertical alignment noise.
resharper_csharp_wrap_linq_expressions = chop_if_long
resharper_csharp_align_multiline_linq_query = false

# Rider / ReSharper: named arguments
#
# Existing named arguments can carry meaning in functional calls such as
# Match(some: ..., none: ...). Do not enforce named arguments everywhere, but
# also do not flag existing named arguments as candidates for positional style.
resharper_arguments_style_named_expression_highlighting = none

# Tests
#
# Underscores make test names easier to read:
# MethodUnderTest_State_ExpectedResult.
[**/*.Tests/*.cs]
dotnet_diagnostic.CA1707.severity = none

[**/*.Tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

[**/tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

# Naming conflicts
#
# Keep CA1724 active by default, but suppress it for conventional extension/DI
# entrypoint files where the name is intentional.

# Aspire service defaults commonly use a static Extensions class in
# Microsoft.Extensions.Hosting. Keep the generated/conventional shape.
[**/*.ServiceDefaults/Extensions.cs]
dotnet_diagnostic.CA1724.severity = none

# Clean architecture projects commonly expose DependencyInjection.cs as the
# project-level composition entrypoint.
[**/DependencyInjection.cs]
dotnet_diagnostic.CA1724.severity = none
