<Project Sdk="Microsoft.NET.Sdk">

    <Sdk Name="Aspire.AppHost.Sdk" Version="13.3.0"/>

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <!--#if (db == "TemplateAuthoringOnly") -->
    <ItemGroup>
        <Compile Remove="Providers\AspireDatabase.PostgreSql.cs" Condition="'$(EffectiveDbProvider)' != 'PostgreSql'"/>
        <Compile Remove="Providers\AspireDatabase.SqlServer.cs" Condition="'$(EffectiveDbProvider)' != 'SqlServer'"/>
    </ItemGroup>
    <!--#endif -->

    <!--#if (auth == "TemplateAuthoringOnly") -->
    <ItemGroup>
        <Compile Remove="Containers\KeycloakContainerExtensions.cs" Condition="'$(EffectiveAuthProvider)' != 'Keycloak'"/>
        <Compile Remove="Containers\KeycloakContainerOptions.cs" Condition="'$(EffectiveAuthProvider)' != 'Keycloak'"/>
    </ItemGroup>
    <!--#endif -->

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost"/>
        <!--#if (db == "PostgreSql") -->
        <PackageReference Include="Aspire.Hosting.PostgreSQL"/>
        <!--#endif -->
        <!--#if (db == "SqlServer") -->
        <PackageReference Include="Aspire.Hosting.SqlServer"/>
        <!--#endif -->
        <!--#if (auth == "Keycloak") -->
        <PackageReference Include="Aspire.Hosting.Keycloak"/>
        <!--#endif -->
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Company.Template.Composition\Company.Template.Composition.csproj"/>
        <ProjectReference Include="..\Company.Template.MigrationService\Company.Template.MigrationService.csproj"/>
    </ItemGroup>

</Project>